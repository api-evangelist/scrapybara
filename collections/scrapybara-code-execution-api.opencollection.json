{
  "opencollection": "1.0.0",
  "info": {
    "name": "Scrapybara Auth States Code Execution API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Code Execution",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run bash actions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.scrapybara.com/v1/instances/:instance_id/bash",
            "params": [
              {
                "name": "instance_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a bash command on the instance."
        },
        {
          "info": {
            "name": "Execute code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.scrapybara.com/v1/instances/:instance_id/code/execute",
            "params": [
              {
                "name": "instance_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute code against a named kernel on the instance."
        }
      ]
    }
  ],
  "bundled": true
}